{
  "$schema": "https://raw.githubusercontent.com/ErikReider/SwayNotificationCenter/refs/heads/main/src/configSchema.json",
  "positionX": "right",
  "ignore-gtk-theme": true,
  "positionY": "top",
  "cssPriority": "user",
  "fit-to-screen": true,
  "control-center-width": 430,
  "control-center-height": 300,
  "control-center-margin-top": 15,
  "control-center-margin-bottom": 15,
  "control-center-margin-right": 15,
  "control-center-margin-left": 15,
  "notification-window-width": 400,
  "notification-body-image-height": 200,
  "notification-body-image-width": 200,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "relative-timestamps": true,
  "notification-grouping": true,
  "text-empty": "Aucune notification",
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "script-fail-notify": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "notification-visibility": {
    "example-name": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify"
    }
  },
  "widgets": [
    "title",
    "dnd",
    "inhibitors",
    "notifications",
    "mpris",
    "backlight",
    "volume",
    "buttons-grid"
  ],
  "widget-config": {
    "title": {
      "text": "Centre de notifications",
      "clear-all-button": true,
      "button-text": "Tout effacer"
    },
    "dnd": {
      "text": "Ne pas déranger"
    },
    "inhibitors": {
      "text": "Notifications suspendues",
      "clear-all-button": true,
      "button-text": "Réactiver"
    },
    "notifications": {
      "vexpand": true
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true,
      "loop-carousel": true
    },
    "backlight": {
      "label": " 󰃟 ",
      "device": "intel_backlight",
      "min": 10
    },
    "volume": {
      "label": " 󰕾 "
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖩",
          "type": "toggle",
          "command": "swaync-actions wifi-toggle",
          "update-command": "swaync-actions wifi-state"
        },
        {
          "label": "",
          "type": "toggle",
          "command": "swaync-actions bluetooth-toggle",
          "update-command": "swaync-actions bluetooth-state"
        },
        {
          "label": "󰖔",
          "type": "toggle",
          "command": "swaync-actions night-toggle",
          "update-command": "swaync-actions night-state"
        },
        {
          "label": "󰍭",
          "type": "toggle",
          "command": "swaync-actions mic-toggle",
          "update-command": "swaync-actions mic-state"
        },
        {
          "label": "󰄀",
          "command": "swaync-actions screenshot"
        },
        {
          "label": "",
          "command": "swaync-actions clipboard"
        },
        {
          "label": "󰾆",
          "type": "toggle",
          "command": "swaync-actions power-toggle",
          "update-command": "swaync-actions power-state"
        },
        {
          "label": "󰌾",
          "command": "swaync-actions lock"
        },
        {
          "label": "⏻",
          "command": "swaync-actions power-menu"
        }
      ]
    }
  }
}
