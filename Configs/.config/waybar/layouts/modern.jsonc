// Modern HyDE: calm navigation, contextual centre, compact system controls.
// Secondary actions stay available through the HyDE menu and control centre.
{
    "layer": "top",
    "position": "top",
    "output": ["*"],
    "height": 34,
    "margin-top": 7,
    "margin-left": 10,
    "margin-right": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "hyde-pinned-apps": false,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "modules-left": ["group/modern-nav"],
    "modules-center": ["group/modern-context"],
    "modules-right": ["group/modern-status"],
    "group/modern-nav": {
        "orientation": "inherit",
        "modules": ["group/modern-launchers", "hyprland/workspaces"]
    },
    "group/modern-launchers": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 220,
            "children-class": "modern-launchers-drawer",
            "transition-left-to-right": true
        },
        "modules": ["custom/app-launcher", "custom/files", "custom/hyde-menu"]
    },
    "group/modern-context": {
        "orientation": "inherit",
        "modules": ["hyprland/window"]
    },
    "group/modern-status": {
        "orientation": "inherit",
        "modules": [
            "group/modern-tools",
            "network",
            "pulseaudio",
            "battery",
            "clock",
            "custom/power"
        ]
    },
    "group/modern-tools": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 250,
            "children-class": "modern-tools-drawer",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/swaync",
            "privacy",
            "idle_inhibitor",
            "pulseaudio#microphone",
            "backlight",
            "tray"
        ]
    }
}
