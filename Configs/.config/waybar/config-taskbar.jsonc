{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "margin-bottom": 10,
  "margin-left": 260,
  "margin-right": 260,
  "spacing": 0,
  "exclusive": false,
  "passthrough": false,

  "modules-left": [],
  "modules-center": ["wlr/taskbar"],
  "modules-right": [],

  "wlr/taskbar": {
    "all-outputs": false,
    "active-first": false,
    "markup": true,
    "format": "{icon}",
    "icon-size": 22,
    "icon-theme": "Tela-circle-yellow",
    "spacing": 6,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
    "ignore-list": [""],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition",
      "firefoxnightly": "firefox-nightly",
      "Spotify Free": "Spotify"
    },
    "rewrite": {
      "Firefox Web Browser": "Firefox",
      "Foot Server": "Terminal",
      "org.kde.dolphin": "Dolphin"
    }
  }
}
