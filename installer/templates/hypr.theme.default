# Canonical minimal hypr.theme for this fork's offline-generated "Default"
# theme. hyprlang variable syntax ($KEY = value), read by hyq (color/hypr.sh,
# theme.switch.sh) and by globalcontrol.sh's get_hyprConf() grep/awk fallback
# when hyq is unavailable - see installer/theme.manifest.
#
# Values match the shipped fallback defaults in
# Configs/.local/share/hyde/env-theme so a freshly repaired Default theme
# renders identically to what those defaults already describe.
$GTK_THEME = Wallbash-Gtk
$ICON_THEME = Tela-circle-dracula
$COLOR_SCHEME = prefer-dark
$CURSOR_THEME = Bibata-Modern-Ice
$CURSOR_SIZE = 24
$FONT = Cantarell
$FONT_STYLE = Regular
$FONT_SIZE = 10
$DOCUMENT_FONT = Cantarell
$DOCUMENT_FONT_SIZE = 10
$MONOSPACE_FONT = CaskaydiaCove Nerd Font Mono
$MONOSPACE_FONT_SIZE = 9
$CODE_THEME = Wallbash
